APP_NAME=stockapp-backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080
PANDAAI_USERNAME=your_pandaai_username
PANDAAI_PASSWORD=your_pandaai_password
PANDAAI_BASE_URL=http://pandadata.pandaaiquant.com
PANDAAI_TIMEOUT_SECONDS=15
PANDAAI_MAX_RETRIES=2
PANDAAI_VERIFY_SSL=true
PANDAAI_CACHE_TTL_SECONDS=60
